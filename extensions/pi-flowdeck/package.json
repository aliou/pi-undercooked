{
  "name": "@aliou/pi-undercooked-pi-flowdeck",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "flowdeck",
    "xcode",
    "ios",
    "macos",
    "simulator",
    "ui-automation"
  ],
  "pi": {
    "extensions": [
      "./src/tools/index.ts",
      "./src/hooks/index.ts"
    ],
    "skills": [
      "./skills/flowdeck"
    ],
    "video": "https://assets.aliou.me/pi-extensions/demos/pi-flowdeck.mp4"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "skills",
    "schema.json",
    "README.md"
  ],
  "dependencies": {
    "@aliou/pi-utils-settings": "^0.18.0",
    "@aliou/pi-utils-ui": "^0.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.8.1",
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.27.11",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "^25.0.10",
    "husky": "^9.1.7",
    "ts-json-schema-generator": "^2.4.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "@earendil-works/pi-ai": "$@earendil-works/pi-coding-agent",
      "@earendil-works/pi-tui": "$@earendil-works/pi-coding-agent"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "gen:schema": "ts-json-schema-generator --path src/config.ts --type FlowDeckConfig --no-type-check -o schema.json",
    "check:schema": "ts-json-schema-generator --path src/config.ts --type FlowDeckConfig --no-type-check -o /tmp/schema-check.json && diff -q schema.json /tmp/schema-check.json",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "prepare": "[ -d .git ] && husky || true",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm changeset publish"
  },
  "packageManager": "pnpm@10.26.1"
}
