{
  "name": "@aliou/pi-nurb",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/aliou/pi-nurb"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "nurb",
    "cad"
  ],
  "pi": {
    "extensions": [
      "./extensions/nurb/index.ts"
    ],
    "skills": [
      "./skills/nurb-pi"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "!extensions/**/*.test.ts",
    "skills",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.14.0",
    "@biomejs/biome": "^2.5.13",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^25.0.10",
    "typebox": "1.3.7",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run"
  },
  "packageManager": "pnpm@11.5.1"
}
